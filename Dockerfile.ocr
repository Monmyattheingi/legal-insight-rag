FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       poppler-utils \
       tesseract-ocr \
       tesseract-ocr-mya \
       tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-ocr.txt .
RUN pip install --no-cache-dir -r requirements-ocr.txt
COPY ocr_service.py .
COPY legal_analysis.py .
COPY grounded_answer.py .
COPY penalty_matching.py .
COPY frontend_static ./frontend_static

EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "2", "--timeout", "900", "ocr_service:app"]
